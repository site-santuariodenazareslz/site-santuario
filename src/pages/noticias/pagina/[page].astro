---
import PageLayout from "../../../components/PageLayout.astro";
import type { Page } from "../../../lib/types";

export function getStaticPaths() {
  const modules = import.meta.glob("../../../content/news/**/index.json", {
    eager: true,
  });
  const totalPages = Math.ceil(Object.values(modules).length / 9);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const page: Page = {
  title: `Notícias | Página ${currentPage}`,
  description: "Acompanhe as notícias do Santuário Nossa Senhora de Nazaré.",
  blocks: [
    { type: "fragment", name: "header" },
    {
      type: "section-header",
      eyebrow: "Comunicados",
      title: "Últimas Notícias",
      description: "Acompanhe as novidades, celebrações e ações da comunidade.",
    },
    {
      type: "all-news",
      currentPage,
    },
  ],
};
---

<PageLayout page={page} />
