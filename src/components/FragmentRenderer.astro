---
import Header from "./blocks/Header/Header.astro";
import Footer from "./blocks/Footer/Footer.astro";
import Hero from "./blocks/Hero/Hero.astro";
import BannerText from "./blocks/BannerText/BannerText.astro";
import CardEvent from "./blocks/CardEvent/CardEvent.astro";
import BannerCarousel from "./blocks/BannerCarousel/BannerCarousel.astro";
import Donation from "./blocks/Donation/Donation.astro";
import MassSchedule from "./blocks/MassSchedule/MassSchedule.astro";
import News from "./blocks/News/News.astro";
import AllNews from "./blocks/AllNews/AllNews.astro";
import NewsBanner from "./blocks/NewsBanner/NewsBanner.astro";
import NewsText from "./blocks/NewsText/NewsText.astro";
import NewsImage from "./blocks/NewsImage/NewsImage.astro";
import type { Block } from "../lib/types";

const { blocks } = Astro.props as { blocks: Block[] };
const componentFor = {
  header: Header,
  footer: Footer,
  hero: Hero,
  "banner-text": BannerText,
  "card-event": CardEvent,
  "banner-carousel": BannerCarousel,
  donation: Donation,
  "mass-schedule": MassSchedule,
  news: News,
  "all-news": AllNews,
  "news-banner": NewsBanner,
  "news-text": NewsText,
  "news-image": NewsImage,
} as const;

if (blocks.some((block) => block.type === "fragment")) {
  throw new Error("Fragmentos não podem referenciar outros fragmentos.");
}

const renderableBlocks = blocks.filter(
  (block) => block.type !== "fragment",
) as Exclude<Block, { type: "fragment" }>[];
---

{
  renderableBlocks.map((block) => {
    const Component = componentFor[block.type];
    return <Component {...block} />;
  })
}
