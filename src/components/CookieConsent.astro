---
import "./CookieConsent.scss";

const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
  gaId && (
    <aside
      class="cookie-consent"
      role="dialog"
      aria-labelledby="cookie-consent-title"
      aria-describedby="cookie-consent-description"
    >
      <div class="cookie-consent__content">
        <div>
          <p class="cookie-consent__eyebrow">Privacidade</p>
          <h2 id="cookie-consent-title">Preferências de cookies</h2>
          <p id="cookie-consent-description">
            Usamos cookies para entender como o site é utilizado e melhorar a
            experiência. Você pode aceitar ou rejeitar os cookies de análise.
          </p>
        </div>

        <div class="cookie-consent__actions">
          <button
            class="cookie-consent__button cookie-consent__button--secondary"
            type="button"
            data-cookie-reject
          >
            Rejeitar
          </button>
          <button
            class="cookie-consent__button cookie-consent__button--primary"
            type="button"
            data-cookie-accept
          >
            Aceitar
          </button>
        </div>
      </div>
    </aside>
  )
}

<script define:vars={{ gaId }}>
  const storageKey = "santuario-cookie-consent";
  const analyticsScriptId = "santuario-ga4-script";

  const saveConsent = (accepted) => {
    localStorage.setItem(storageKey, accepted ? "accepted" : "rejected");
  };

  const isAccepted = () => localStorage.getItem(storageKey) === "accepted";

  const loadAnalytics = () => {
    if (document.getElementById(analyticsScriptId)) return;

    const script = document.createElement("script");
    script.id = analyticsScriptId;
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);

    const configScript = document.createElement("script");
    configScript.textContent = `
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "${gaId}");
    `;
    document.head.appendChild(configScript);
  };

  const consent = document.querySelector(".cookie-consent");
  const acceptButton = consent?.querySelector("[data-cookie-accept]");
  const rejectButton = consent?.querySelector("[data-cookie-reject]");

  if (consent && acceptButton && rejectButton) {
    const setConsent = (accepted) => {
      saveConsent(accepted);
      consent.hidden = true;

      if (accepted) loadAnalytics();
    };

    if (localStorage.getItem(storageKey) === "accepted") {
      consent.hidden = true;
      loadAnalytics();
    } else if (localStorage.getItem(storageKey) === "rejected") {
      consent.hidden = true;
    }

    acceptButton.addEventListener("click", () => setConsent(true));
    rejectButton.addEventListener("click", () => setConsent(false));
  }
</script>
