---
import type { TeaserImageBlock } from "../../../lib/types";
import { siteUrl } from "../../../lib/urls";
import "./TeaserImage.scss";

const { image, imageAlt, title, text } = Astro.props as TeaserImageBlock;
---

<section class="teaser-image">
  <img class="teaser-image__photo" src={siteUrl(image)} alt={imageAlt} />
  <div class="teaser-image__body">
    <h2>{title}</h2>
    <div class="teaser-image__text" set:html={text} />
  </div>
</section>
