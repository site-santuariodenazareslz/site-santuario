---
import type { EventItem } from "../../../lib/types";
import { categoriesForEvent } from "../../../lib/event-utils";
import { siteUrl } from "../../../lib/urls";
import "./EventCard.scss";

const { event, hidden = false } = Astro.props as {
  event: EventItem;
  hidden?: boolean;
};
const categories = categoriesForEvent(event);

const date = new Date(`${event.startDate}T12:00:00`);
const dateLabel = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "short",
})
  .format(date)
  .replace(".", "");
const [day, month] = dateLabel.split(" de ");
const displayedDate = month
  ? { day, month }
  : {
      day: String(date.getDate()).padStart(2, "0"),
      month: new Intl.DateTimeFormat("pt-BR", { month: "short" })
        .format(date)
        .replace(".", ""),
    };
const calendarEnd = new Date(`${event.startDate}T${event.startTime}:00`);
if (event.endTime) {
  const [endHour, endMinute] = event.endTime.split(":").map(Number);
  calendarEnd.setHours(endHour, endMinute, 0, 0);
  if (calendarEnd <= new Date(`${event.startDate}T${event.startTime}:00`)) {
    calendarEnd.setDate(calendarEnd.getDate() + 1);
  }
} else {
  calendarEnd.setHours(calendarEnd.getHours() + 1);
}
const calendarEndDate = [
  calendarEnd.getFullYear(),
  String(calendarEnd.getMonth() + 1).padStart(2, "0"),
  String(calendarEnd.getDate()).padStart(2, "0"),
].join("-");
const calendarEndTime = [
  String(calendarEnd.getHours()).padStart(2, "0"),
  String(calendarEnd.getMinutes()).padStart(2, "0"),
].join(":");
---

<article
  class="event-card"
  data-event-card
  data-start-date={event.startDate}
  hidden={hidden}
>
  <div class="event-card__image-wrap">
    <img
      src={siteUrl(event.image)}
      alt={event.imageAlt}
      class="event-card__image"
      loading="lazy"
    />
    <time class="event-card__date" datetime={event.startDate}>
      <strong>{displayedDate.day}</strong>
      <span>{displayedDate.month}</span>
    </time>
  </div>
  <div class="event-card__body">
    {
      categories.length > 0 && (
        <span class="event-card__category">{categories.join(" · ")}</span>
      )
    }
    <h3>{event.title}</h3>
    <p class="event-card__description">{event.description}</p>
    <dl class="event-card__details">
      <div><dt>Data</dt><dd>{date.toLocaleDateString("pt-BR")}</dd></div>
      <div>
        <dt>Horário</dt>
        <dd>
          {
            event.endTime
              ? `${event.startTime}–${event.endTime}`
              : event.startTime
          }
        </dd>
      </div>
      <div><dt>Local</dt><dd>{event.location}</dd></div>
    </dl>
    <button
      class="event-card__calendar"
      type="button"
      data-calendar-event
      data-title={event.title}
      data-description={event.description}
      data-location={event.location}
      data-start-date={event.startDate}
      data-start-time={event.startTime}
      data-end-date={calendarEndDate}
      data-end-time={calendarEndTime}>Adicionar ao calendário</button
    >
  </div>
</article>

<script>
  import { hidePastEvents } from "../../../lib/event-date";

  hidePastEvents([
    ...document.querySelectorAll<HTMLElement>("[data-event-card]"),
  ]);

  const escapeIcsText = (value: string) =>
    value
      .replace(/\\/g, "\\\\")
      .replace(/;/g, "\\;")
      .replace(/,/g, "\\,")
      .replace(/\n/g, "\\n");
  const toIcsDate = (date: string, time: string) =>
    `${date.replaceAll("-", "")}T${time.replace(":", "")}00`;

  document
    .querySelectorAll<HTMLButtonElement>("[data-calendar-event]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const data = button.dataset;
        if (
          !data.title ||
          !data.startDate ||
          !data.startTime ||
          !data.endDate ||
          !data.endTime
        )
          return;
        const content = [
          "BEGIN:VCALENDAR",
          "VERSION:2.0",
          "PRODID:-//Santuario Nossa Senhora de Nazare//Agenda//PT-BR",
          "CALSCALE:GREGORIAN",
          "BEGIN:VEVENT",
          `UID:${crypto.randomUUID()}@santuario`,
          `DTSTAMP:${new Date()
            .toISOString()
            .replace(/[-:]/g, "")
            .replace(/\.\d{3}/, "")}`,
          `DTSTART:${toIcsDate(data.startDate, data.startTime)}`,
          `DTEND:${toIcsDate(data.endDate, data.endTime)}`,
          `SUMMARY:${escapeIcsText(data.title)}`,
          `DESCRIPTION:${escapeIcsText(data.description ?? "")}`,
          `LOCATION:${escapeIcsText(data.location ?? "")}`,
          "END:VEVENT",
          "END:VCALENDAR",
        ].join("\r\n");
        const url = URL.createObjectURL(
          new Blob([content], { type: "text/calendar;charset=utf-8" }),
        );
        const link = document.createElement("a");
        link.href = url;
        link.download = `${data.title
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-")}.ics`;
        link.click();
        URL.revokeObjectURL(url);
      });
    });
</script>
