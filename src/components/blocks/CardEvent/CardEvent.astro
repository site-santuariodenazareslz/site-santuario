---
import type { CardEventBlock } from "../../../lib/types";
import { events } from "../../../lib/events";
import { eventsForCategories } from "../../../lib/event-utils";
import { eventsOnOrAfterDate } from "../../../lib/event-date";
import EventCard from "../EventCard/EventCard.astro";
import "./CardEvent.scss";

const block = Astro.props as CardEventBlock;
const listedEvents = eventsOnOrAfterDate(
  eventsForCategories(events, block.categories ?? []),
);
const headingId = `${block.id ?? "card-event"}-title`;
---

<section
  id={block.id}
  class="card-event"
  aria-labelledby={block.title ? headingId : undefined}
>
  {
    (block.title || block.text) && (
      <header class="card-event__heading">
        {block.title && <h2 id={headingId}>{block.title}</h2>}
        {block.text && <div class="card-event__text" set:html={block.text} />}
      </header>
    )
  }
  {
    listedEvents.length > 0 && (
      <div class="card-event__carousel" data-card-event-carousel>
        <button
          class="card-event__arrow card-event__arrow--previous"
          type="button"
          aria-label="Eventos anteriores"
          data-card-event-previous
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <div class="card-event__viewport" data-card-event-viewport>
          <div class="card-event__track" data-card-event-track>
            {listedEvents.map((event) => (
              <div class="card-event__slide">
                <EventCard event={event} />
              </div>
            ))}
          </div>
        </div>
        <button
          class="card-event__arrow card-event__arrow--next"
          type="button"
          aria-label="Próximos eventos"
          data-card-event-next
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
        <div
          class="card-event__dots"
          role="group"
          aria-label="Páginas de eventos"
          data-card-event-dots
        />
      </div>
    )
  }
  {
    listedEvents.length === 0 && (
      <p class="card-event__empty">
        Nenhum evento corresponde às categorias selecionadas.
      </p>
    )
  }
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-card-event-carousel]")
    .forEach((carousel) => {
      const viewport = carousel.querySelector<HTMLElement>(
        "[data-card-event-viewport]",
      );
      const track = carousel.querySelector<HTMLElement>(
        "[data-card-event-track]",
      );
      const previous = carousel.querySelector<HTMLButtonElement>(
        "[data-card-event-previous]",
      );
      const next = carousel.querySelector<HTMLButtonElement>(
        "[data-card-event-next]",
      );
      const dots = carousel.querySelector<HTMLElement>(
        "[data-card-event-dots]",
      );
      if (!viewport || !track || !previous || !next || !dots) return;

      const slides = [
        ...track.querySelectorAll<HTMLElement>(".card-event__slide"),
      ];
      const visibleCount = () =>
        window.matchMedia("(max-width: 620px)").matches
          ? 1
          : window.matchMedia("(max-width: 900px)").matches
            ? 2
            : 3;
      let page = 0;
      let pageCount = 1;
      let pageDots: HTMLButtonElement[] = [];
      let configuredCount = 0;

      const configure = (count: number) => {
        if (configuredCount === count) return;
        configuredCount = count;
        pageCount = Math.max(1, Math.ceil(slides.length / count));
        page = Math.min(page, pageCount - 1);
        dots.replaceChildren();
        pageDots = Array.from({ length: pageCount }, (_, index) => {
          const dot = document.createElement("button");
          dot.className = "card-event__dot";
          dot.type = "button";
          dot.setAttribute(
            "aria-label",
            `Ir para o grupo ${index + 1} de ${pageCount}`,
          );
          dot.addEventListener("click", () => {
            page = index;
            update();
          });
          dots.append(dot);
          return dot;
        });
      };

      const update = () => {
        const count = visibleCount();
        configure(count);
        page = Math.min(page, pageCount - 1);
        track.style.width = `${(slides.length / count) * 100}%`;
        slides.forEach((slide) => {
          slide.style.flexBasis = `${100 / slides.length}%`;
        });
        track.style.transform = `translateX(-${(page * count * 100) / slides.length}%)`;
        previous.disabled = page === 0;
        next.disabled = page === pageCount - 1;
        previous.hidden = pageCount <= 1;
        next.hidden = pageCount <= 1;
        dots.hidden = pageCount <= 1;
        pageDots.forEach((dot, index) => {
          dot.classList.toggle("is-active", index === page);
          dot.setAttribute("aria-current", index === page ? "true" : "false");
        });
      };

      previous.addEventListener("click", () => {
        page = Math.max(0, page - 1);
        update();
      });
      next.addEventListener("click", () => {
        page = Math.min(pageCount - 1, page + 1);
        update();
      });
      window.addEventListener("resize", update);
      update();
    });
</script>
