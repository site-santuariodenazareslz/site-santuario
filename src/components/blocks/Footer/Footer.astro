---
import type { FooterBlock } from "../../../lib/types";
import { siteUrl } from "../../../lib/urls";
import "./Footer.scss";

const {
  eyebrow,
  brand,
  description,
  logo,
  quickLinks,
  services,
  contacts,
  officeLabel,
  officeHours,
  copyright,
  diocese,
} = Astro.props as FooterBlock;

const linesFor = (value: string, splitSemicolons = false) =>
  value
    .split(splitSemicolons ? /\r?\n|(?<=;)\s*/ : /\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);
const officeLines = linesFor(officeHours, true);
const socialName = (icon: string) => icon.replace(/^@/, "").toLowerCase();
---

<footer class="footer-container">
  <div class="site-footer__background"></div>
  <div class="site-footer">
    <div class="site-footer__main">
      <div class="site-footer__grid">
        <section class="site-footer__brand">
          <a
            class="site-footer__brand-lockup"
            href={siteUrl("/")}
            aria-label={brand}
          >
            {
              logo ? (
                <img class="site-footer__logo" src={siteUrl(logo)} alt="" />
              ) : (
                <span class="site-footer__mark" aria-hidden="true">
                  <span />
                </span>
              )
            }
            <span><small>{eyebrow}</small><strong>{brand}</strong></span>
          </a>
          {description && <p>{description}</p>}
          <nav class="site-footer__social" aria-label="Redes sociais">
            {
              contacts
                .filter(
                  (contact) => contact.icon && contact.icon.startsWith("@"),
                )
                .map((contact) => (
                  <a href={contact.text} aria-label={contact.icon.replace("@", "")}>
                    {
                      socialName(contact.icon) === "instagram" ? (
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
                      ) : socialName(contact.icon) === "youtube" ? (
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12s0-4.2-.54-5.43a2.9 2.9 0 0 0-2.03-2.03C17.2 4 12 4 12 4s-5.2 0-6.43.54A2.9 2.9 0 0 0 3.54 6.57C3 7.8 3 12 3 12s0 4.2.54 5.43a2.9 2.9 0 0 0 2.03 2.03C6.8 20 12 20 12 20s5.2 0 6.43-.54a2.9 2.9 0 0 0 2.03-2.03C21 16.2 21 12 21 12Z" /><path d="m10 15 5-3-5-3v6Z" fill="currentColor" stroke="none" /></svg>
                      ) : socialName(contact.icon) === "facebook" ? (
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 21v-8h3l.5-3H14V8.1c0-.87.24-1.46 1.5-1.46H17.6V3.96c-.36-.05-1.6-.16-3.08-.16-3.04 0-5.12 1.86-5.12 5.27V10H6v3h3.4v8H14Z" fill="currentColor" stroke="none" /></svg>
                      ) : socialName(contact.icon) === "whatsapp" ? (
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.56 7.48L3.5 20.5l1.22-4.3A8.5 8.5 0 1 1 20.5 11.8Z" /><path d="M8.2 7.8c.2-.45.42-.46.62-.47h.53c.16 0 .38.06.48.3l.7 1.65c.08.2.06.36-.02.51l-.3.48c-.1.13-.2.27-.08.48.12.22.53.87 1.15 1.4.8.72 1.48.94 1.7 1.05.2.1.34.08.47-.05l.6-.7c.15-.18.3-.15.5-.08l1.6.75c.25.12.4.18.46.28.06.1.06.6-.14 1.16-.2.55-1.13 1.04-1.56 1.1-.4.06-.9.08-1.45-.1-.34-.1-.78-.26-1.35-.5-2.35-1.02-3.88-3.4-4-3.56-.1-.16-.95-1.26-.95-2.4 0-1.14.6-1.7.8-1.94Z" fill="currentColor" stroke="none" /></svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 14 21 3M15 3h6v6M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" /></svg>
                      )
                    }
                  </a>
                ))
            }
          </nav>
        </section>

        <section class="site-footer__links">
          <h2>Links Rápidos</h2>
          <ul>
            {
              quickLinks.map((link) => (
                <li>
                  <a href={siteUrl(link.href)}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="site-footer__links">
          <h2>Círios</h2>
          <ul>
            {
              services.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="site-footer__contact">
          <h2>Contato</h2>
          <div class="site-footer__contact-list">
            {
              contacts
                .filter((contact) => !contact.icon.startsWith("@"))
                .map((contact) => (
                  <p>
                    <span aria-hidden="true">{contact.icon}</span>
                    <span class="site-footer__contact-text">
                      {linesFor(contact.text).map((line) => <span>{line}</span>)}
                    </span>
                  </p>
                ))
            }
          </div>
          {
            officeLabel && (
              <div class="site-footer__office">
                <>
                  <small>{officeLabel}</small>
                  <p>{officeLines.map((line) => <span>{line}</span>)}</p>
                </>
              </div>
            )
          }
        </section>
      </div>
    </div>
    <div class="site-footer__legal">
      <span>{copyright}</span><span>{diocese}</span>
    </div>
  </div>
</footer>
