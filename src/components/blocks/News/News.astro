---
import type { NewsItem, NewsListingBlock } from "../../../lib/types";
import { summarizeNews } from "../../../lib/news";
import { siteUrl } from "../../../lib/urls";
import NewsCard from "../NewsCard/NewsCard.astro";
import "./News.scss";

const block = Astro.props as NewsListingBlock;
const modules = import.meta.glob("../../../content/news/**/index.json", {
  eager: true,
});
const news = Object.values(modules)
  .map((module) => (module as { default: NewsItem }).default)
  .sort((a, b) => b.createdAt.localeCompare(a.createdAt))
  .slice(0, 3)
  .map(summarizeNews);
---

<section id={block.id ?? "noticias"} class="news-container">
  <div class="news-preview__background"></div>
  <div class="news-preview">
    <div class="news-preview__grid">
      {news.map((item) => <NewsCard news={item} />)}
    </div>
    {block.allLabel && block.allHref && <a class="news-preview__all" href={siteUrl(block.allHref)}>{block.allLabel} <span aria-hidden="true">→</span></a>}
  </div>
</section>
