---
import { siteUrl } from "../../../lib/urls";
import type { NotFoundBlock } from "../../../lib/types";
import "./NotFound.scss";

const { eyebrow, title, description, actionLabel, actionHref } =
  Astro.props as NotFoundBlock;
---

<section class="not-found" aria-labelledby="not-found-title">
  <div class="not-found__content">
    <p class="not-found__code" aria-hidden="true">404</p>
    <p class="not-found__eyebrow">{eyebrow}</p>
    <h1 id="not-found-title">{title}</h1>
    <p>{description}</p>
    <a class="not-found__action" href={siteUrl(actionHref)}>{actionLabel}</a>
  </div>
</section>
