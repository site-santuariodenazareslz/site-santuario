---
import type { SectionHeaderBlock } from "../../../lib/types";
import "./SectionHeader.scss";

const { eyebrow, title, description } = Astro.props as SectionHeaderBlock;
---

<div class="section-header">
  {
    eyebrow && (
      <p class="section-header__eyebrow">
        <span aria-hidden="true" />
        {eyebrow}
        <span aria-hidden="true" />
      </p>
    )
  }
  <h2>{title}</h2>
  {description && <p class="section-header__description">{description}</p>}
</div>
